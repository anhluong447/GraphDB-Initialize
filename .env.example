# OpenRouter API Key
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Target project to index
CODEBASE_PATH=./demo_project/A20-App-083

# Models (via OpenRouter)
LLM_MODEL=deepseek/deepseek-v4-flash
EMBEDDING_MODEL=openai/text-embedding-3-large

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag123

# ChromaDB
CHROMA_PATH=./chroma_db

# ChromaDB Embeddings Dimension
EMBEDDING_DIMENSIONS=512

# GitHub (optional)
GITHUB_TOKEN=
GITHUB_REPO=

# ═══════════════════════════════════════════════════════════
# Server Mode Configuration
# ═══════════════════════════════════════════════════════════
# Enable server mode (data stored in ./server_data/ instead of codebase)
SERVER_MODE=false

# API Key for authenticating client requests (leave empty to disable auth)
API_KEY=

# Webhook URL for Auto-Test Agent callbacks (leave empty to disable)
WEBHOOK_URL=

# Directory for cloned repos when using remote Git URLs
WORKSPACE_DIR=./workspace
